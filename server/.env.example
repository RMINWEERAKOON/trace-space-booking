# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_TIME_ZONE=Asia/Colombo

# Optional administrator credentials. Set these before the first server start.
# If ADMIN_PASSWORD is blank, the server generates a random one and prints it once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set a long, random secret (at least 32 random characters) to keep sessions valid across restarts.
# If blank, the server creates an in-memory secret and sessions expire when the server restarts.
TOKEN_SECRET=

# Optional email notifications. Bookings and inquiries still save when SMTP is not configured.
# A booking confirmation is sent to the customer email after a booking is saved.
# Inquiry notifications are sent to ADMIN_EMAIL.
ADMIN_EMAIL=facilities@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TRACE Expert City Bookings <bookings@example.com>
